{{ header }}
<div id="product-info" class="container">
  <div class="row">
    {{ column_left }}
    <div id="content" class="col">
      {{ content_top }}
      
      <h1>{{ name }}</h1>
      
      <div class="row mb-3">
        <div class="col-md-12">
          <p><strong>{{ text_shop_details }}</strong></p>
          <p><i class="fa-solid fa-globe"></i> <a href="https://{{ domain }}" target="_blank">{{ domain }}</a></p>
          {% if country %}
            <p><i class="fa-solid fa-location-dot"></i> {{ country }}</p>
          {% endif %}
        </div>
      </div>

      <div class="row mb-3">
        <div class="col-md-12">
          <h2>{{ text_products }}</h2>
          
          <!-- Product Filter/Sort Controls -->
          <div class="row mb-3">
            <div class="col-md-6">
              <input type="text" id="product-search" class="form-control" placeholder="Search products...">
            </div>
            <div class="col-md-3">
              <select id="product-sort" class="form-select">
                <option value="TITLE">Sort by Title</option>
                <option value="PRICE">Sort by Price</option>
                <option value="CREATED_AT">Sort by Newest</option>
                <option value="BEST_SELLING">Sort by Best Selling</option>
              </select>
            </div>
            <div class="col-md-3">
              <button id="apply-filters" class="btn btn-primary w-100">Apply</button>
            </div>
          </div>
          
          <!-- Products Grid -->
          <div id="shop-products" class="row">
            <div class="col-12 text-center">
              <i class="fa-solid fa-spinner fa-spin fa-2x"></i>
              <p class="mt-2">Loading products...</p>
            </div>
          </div>
          
          <!-- Load More Button -->
          <div id="load-more-container" class="text-center mt-4" style="display: none;">
            <button id="load-more-btn" class="btn btn-outline-primary">Load More Products</button>
          </div>
        </div>
      </div>
      
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>

<!-- Include Storefront API JavaScript -->
<script src="catalog/view/extension/cogmart/marketplace/javascript/storefront-api.js"></script>

<script type="text/javascript">
$(document).ready(function() {
    var shopDomain = '{{ domain }}';
    var storefrontAccessToken = '{{ storefront_access_token }}';
    var currentCursor = null;
    var hasNextPage = false;
    
    /**
     * Load products from Shopify Storefront API
     */
    function loadProducts(append) {
        append = append || false;
        
        if (!storefrontAccessToken) {
            $('#shop-products').html('<div class="col-12"><div class="alert alert-warning">No storefront access token configured for this shop. Please contact the shop administrator.</div></div>');
            return;
        }
        
        var searchQuery = $('#product-search').val() || '';
        var sortKey = $('#product-sort').val() || 'TITLE';
        
        if (!append) {
            $('#shop-products').html('<div class="col-12 text-center"><i class="fa-solid fa-spinner fa-spin fa-2x"></i><p class="mt-2">Loading products...</p></div>');
        }
        
        CogMartStorefront.fetchProducts(shopDomain, storefrontAccessToken, {
            first: 20,
            query: searchQuery,
            sortKey: sortKey
        })
        .then(function(products) {
            if (products.edges.length === 0) {
                if (!append) {
                    $('#shop-products').html('<div class="col-12"><div class="alert alert-info">No products found.</div></div>');
                }
                $('#load-more-container').hide();
                return;
            }
            
            var html = '';
            products.edges.forEach(function(product) {
                html += CogMartStorefront.renderProductCard(product, shopDomain);
            });
            
            if (append) {
                $('#shop-products').append(html);
            } else {
                $('#shop-products').html(html);
            }
            
            // Handle pagination
            hasNextPage = products.pageInfo.hasNextPage;
            if (hasNextPage && products.edges.length > 0) {
                currentCursor = products.edges[products.edges.length - 1].cursor;
                $('#load-more-container').show();
            } else {
                $('#load-more-container').hide();
            }
        })
        .catch(function(error) {
            console.error('Error loading products:', error);
            if (!append) {
                $('#shop-products').html('<div class="col-12"><div class="alert alert-danger">Error loading products: ' + error.message + '</div></div>');
            }
        });
    }
    
    // Initial load
    loadProducts();
    
    // Apply filters button
    $('#apply-filters').on('click', function() {
        loadProducts(false);
    });
    
    // Search on Enter key
    $('#product-search').on('keypress', function(e) {
        if (e.which === 13) {
            loadProducts(false);
        }
    });
    
    // Load more button
    $('#load-more-btn').on('click', function() {
        loadProducts(true);
    });
});
</script>
{{ footer }}
