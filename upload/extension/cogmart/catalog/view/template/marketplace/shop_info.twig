{{ header }}
<div id="product-info" class="container">
  <div class="row">
    {{ column_left }}
    <div id="content" class="col">
      {{ content_top }}
      
      <h1>{{ name }}</h1>
      
      <div class="row mb-3">
        <div class="col-md-12">
          <p><strong>{{ text_shop_details }}</strong></p>
          <p><i class="fa-solid fa-globe"></i> <a href="https://{{ domain }}" target="_blank">{{ domain }}</a></p>
          {% if country %}
            <p><i class="fa-solid fa-location-dot"></i> {{ country }}</p>
          {% endif %}
        </div>
      </div>

      <div class="row">
        <div class="col-md-12">
          <h2>{{ text_products }}</h2>
          <div id="shop-products">
            <p class="text-center">
              <i class="fa-solid fa-spinner fa-spin"></i> Loading products...
            </p>
          </div>
        </div>
      </div>
      
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
